{
  "name": "spending-management",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run web:build && npx cap sync android && npm run android:build",
    "build:debug": "npm run web:build && npx cap sync android && npm run android:build:debug",
    "web:build": "vite build",
    "web:dev": "vite",
    "web:preview": "vite preview --port 4173 --strictPort",
    "android:build": "./android/gradlew -p android :app:assembleRelease",
    "android:build:debug": "./android/gradlew -p android :app:assembleDebug",
    "android:install": "npm run build && bash scripts/android-install release",
    "android:install:debug": "npm run build:debug && bash scripts/android-install debug",
    "checks": "npm run checks:types && npm run checks:lint",
    "checks:types": "vue-tsc --noEmit",
    "checks:lint": "eslint .",
    "tests": "npm run tests:unit",
    "tests:unit": "vitest run",
    "cap:sync": "cap sync",
    "db:dev": "scripts/db-dev",
    "emulator:start": "scripts/emulator-start",
    "emulator:nuke": "scripts/emulator-nuke",
    "emulator:dev": "scripts/emulator-dev",
    "emulator:install": "scripts/emulator-install release",
    "emulator:install:debug": "scripts/emulator-install debug",
    "emulator:app:run": "scripts/emulator-install debug && scripts/emulator-run",
    "emulator:logcat": "scripts/emulator-logcat"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-file-picker": "^8.1.1",
    "@ionic/vue": "^9.0.9",
    "@ionic/vue-router": "^9.0.9",
    "@t3-oss/env-core": "^0.13.11",
    "events": "^3.3.0",
    "ionicons": "^8.1.0",
    "pouchdb-browser": "^9.0.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.9",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "description": "An Ionic project"
}
